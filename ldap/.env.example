# Copy to ldap/.env (gitignored, chmod 600). Never commit real values.
# Get the digest with:
#   docker inspect --format '{{index .RepoDigests 0}}' bitnamilegacy/openldap:2.6
LDAP_IMAGE=bitnamilegacy/openldap@sha256:REPLACE_WITH_DIGEST
LDAP_ADMIN_PASSWORD=generate-with-openssl-rand
LDAP_CONFIG_ADMIN_PASSWORD=generate-with-openssl-rand
# Adds the ldaps:// listener (1636). Requires TLS material in ./tls.
LDAP_ENABLE_TLS=yes
